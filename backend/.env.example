# TaskFlow — variáveis de ambiente do backend
# Copie para .env e preencha com valores reais. Nunca commite o .env.

# Porta do servidor (padrão: 10000)
PORT=10000

# Origem(s) do frontend permitidas por CORS — uma ou mais, separadas por vírgula
FRONTEND_URL=http://localhost:5500

# OBRIGATÓRIO: segredo usado para assinar os JWTs (o servidor não sobe sem ele)
JWT_SECRET=troque-por-um-segredo-forte

# OBRIGATÓRIO: conexão PostgreSQL
DATABASE_URL=postgres://usuario:senha@localhost:5432/taskflow

# 'production' ativa cookies secure/sameSite=none e SSL na conexão do banco
NODE_ENV=development

# Rate limit das rotas de autenticação por IP (janela fixa)
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# Criação de contas demo no boot (roda somente com 'true'; senhas exigem 12+ caracteres)
BOOTSTRAP_ENABLED=false
ADMIN_EMAIL=troque-me@example.com
ADMIN_PASSWORD=troque-por-uma-senha-forte-123
USER_EMAIL=demo@example.com
USER_PASSWORD=troque-por-uma-senha-forte-123
